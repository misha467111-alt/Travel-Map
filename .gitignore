# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Local compile-time configuration (copy from .env.example).
.env
.env.local
.env.audit

# Firebase/Google Services config (contains a project-restricted API key).
android/app/google-services.json

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
node_modules/
/build/
/coverage/
android/build/
ios/build/
**/build/

# Local debug/session artifacts (uiautomator dumps, ad-hoc admin scripts,
# tool caches) - never meant to be part of the source tree.
.adb-home/
.audit-tools/
.tool-appdata/
*.xml
!android/**/*.xml
!ios/**/*.xml
!macos/**/*.xml
!windows/**/*.xml
!linux/**/*.xml
!web/**/*.xml
!third_party/**/*.xml

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Temporary current QA screenshots (qa/master reference images are tracked)
qa/current/*.png
